<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#1A1A2E</color>

    <!-- 页面底色 / 卡片面 / 导航胶囊面 -->
    <color name="bg_surface">#F2F2F4</color>
    <color name="card_bg">#FFFFFF</color>
    <!-- 关于页卡片：白底卡片（与页面表面灰 #F2F2F4 拉开对比，成为可辨识的实心面）；
         滚动时由 AboutActivity 动态调背景 alpha——顶部半透明（流光透射）、上滑变不透明实心白 -->
    <color name="about_card_bg">#FFFFFF</color>
    <color name="nav_surface">#FFFFFF</color>

    <!-- 文字层级 -->
    <color name="text_primary">#1A1A1A</color>
    <color name="text_secondary">#5C5C60</color>
    <color name="text_tertiary">#9A9AA0</color>
    <color name="text_brand">#1A1A2E</color>
    <color name="divider">#E8E8ED</color>

    <!-- 强调色（来自 PPT：#00B0F0） -->
    <color name="accent">#00B0F0</color>
    <color name="accent_soft">#1A00B0F0</color>

    <!-- 列表行按压波纹（浅色加深，按下有明确反馈） -->
    <color name="row_highlight">#33000000</color>

    <!-- 胶囊提示：深色底白字 + 浅色模式用边框勾边，避免与背景融为一体 -->

    <!-- 底部弹卡：遮罩 + 可点击蓝色链接（对齐 PPT 强调蓝） -->
    <color name="sheet_scrim">#59000000</color>
    <color name="text_link">#00B0F0</color>

    <!-- 状态色（来自 PPT：绿填充 B1E8B0 / 绿圆 00B050 / 红字 C00000） -->
    <color name="status_green_fill">#B1E8B0</color>
    <color name="status_green_solid">#00B050</color>
    <color name="status_red">#C00000</color>

    <!-- 关于页动态渐变背景（浅色：柔和蓝紫极光）。AGSL 取前三色做竖向基底 + 流动色斑，向下渐变收尾到 bg_surface -->
    <color name="about_aurora_1">#A9C2FF</color>
    <color name="about_aurora_2">#C7B6FF</color>
    <color name="about_aurora_3">#86D8FF</color>
    <!-- 关于页模块名（随渐变流动而缓慢变色的两种文字色，均保证浅色下可读） -->
    <color name="about_title_1">#1A1A2E</color>
    <color name="about_title_2">#3346A8</color>

    <!-- 功能页开关：轨道开启蓝 / 关闭灰，滑块恒为纯白 -->
    <color name="switch_track_on">#4078EF</color>
    <color name="switch_track_off">#E3E3E8</color>
    <color name="switch_thumb_solid">#FFFFFF</color>
</resources>
