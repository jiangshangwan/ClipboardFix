<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 包可见性（targetSdk 30+）：声明查询输入法服务，否则第三方输入法
         （微信输入法、讯飞输入法等）对本应用不可见，导致「已启用输入法」计数漏统计。 -->
    <queries>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:description="@string/module_description">

        <!-- libxposed 新版模块：作用域走 META-INF/xposed/scope.list，声明走 module.prop + java_init.list，
             不再使用 xposedmodule / xposedminversion / xposedscope 等旧 meta-data -->

        <!-- 主界面：同时作为 LSPosed 设置入口（通过 MODULE_SETTINGS category） -->
        <activity
            android:name=".AboutActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标别名：禁用后桌面图标消失，但 AboutActivity 仍可通过 LSPosed 访问 -->
        <activity-alias
            android:name=".LauncherAlias"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".AboutActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- FileProvider：用于 Android 7+ 安装下载的 APK -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
